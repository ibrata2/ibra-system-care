<Project>
  <!-- Shared by every IBRA SYSTEM CARE project. The engine (IbraCare.Core) is plain net10.0 so it builds and is tested on Linux;
       the app (IbraCare.App) targets Windows. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Company>IBRAPROGRAM — إبراهيم الخزرجي</Company>
    <Product>IBRA SYSTEM CARE</Product>
    <Copyright>تصميم وتطوير وتعريب إبراهيم الخزرجي</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
